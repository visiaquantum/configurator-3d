{
  "name": "configurator-3d",
  "version": "0.1.0",
  "private": true,
  "description": "React 3D configurator: place catalog GLBs inside an enclosure GLB, snap on vertices, export PDF/PNG/GLB.",
  "type": "module",
  "main": "dist/configurator-3d.js",
  "module": "dist/configurator-3d.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/configurator-3d.js",
      "default": "./dist/configurator-3d.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc -b && vite build --mode lib",
    "build:demo": "tsc -b && vite build",
    "lint": "eslint .",
    "verify:snaps": "node scripts/verify-snaps.mjs",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "verify:pilot": "node scripts/verify-pilot-assembly.mjs",
    "verify:kit01": "node scripts/verify-kit01-composition.mjs",
    "example:prepare": "npm run build:lib && node scripts/prepare-react-integration.mjs && npm run verify:integration",
    "verify:integration": "node scripts/verify-react-integration.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm test",
    "test": "npm run build:lib && npm run check:size && vitest run --coverage && npm run verify:assembly && npm run verify:snaps && npm run verify:pilot && npm run verify:kit01",
    "check:size": "node scripts/check-size.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "jspdf": ">=3 <5",
    "nanoid": "^5",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "three": ">=0.180 <0.185",
    "zod": "^4",
    "zustand": "^5"
  },
  "peerDependenciesMeta": {
    "jspdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
